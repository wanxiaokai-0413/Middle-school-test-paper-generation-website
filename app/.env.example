PORT=3001
CORS_ORIGIN=http://localhost:5173

# DeepSeek API key. Keep this value on the server only.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Lightweight OCR for photo question recognition.
# chi_sim recognizes simplified Chinese; eng helps with letters, numbers, and simple math symbols.
OCR_LANGS=chi_sim+eng
# Optional: set this to a folder that contains chi_sim.traineddata and eng.traineddata.
# TESSDATA_PATH=./tessdata
# TESSERACT_CACHE_PATH=./.tesseract-cache
# On Vercel, use a writable temporary path:
# TESSERACT_CACHE_PATH=/tmp/tesseract-cache
